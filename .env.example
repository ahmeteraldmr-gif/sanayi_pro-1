# Copy to .env.local. Fill with real project values; no connection is invented.
# Supabase Project Settings -> API. Publishable key (or legacy anon key) only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Runtime: sanayipro_runtime login, never postgres/service_role/table owner.
# Use a Supabase session/transaction pooler connection as appropriate.
# Preserve TLS verification; add sslmode=verify-full and schema=sanayipro.
DATABASE_URL=

# Sign-up provisioning ONLY: sanayipro_onboarding login (INSERT-only, RLS-bound, cannot
# read other tenants, update, delete or bypass RLS). Same TLS/schema rules as DATABASE_URL.
# Server-side runtime variable; it is NOT a migration or service-role credential.
ONBOARDING_DATABASE_URL=

# CLI ONLY: separate sanayipro_migrator login; direct/session connection.
# Also use schema=sanayipro and sslmode=verify-full here.
# Prisma CLI translates TLS options to require + sslaccept=strict internally.
# Never put this variable in the runtime deployment environment.
MIGRATION_DATABASE_URL=

# PostgreSQL/RLS security tests use an isolated embedded database and need no keys.

# Live verification ONLY. Two separate confirmed Supabase Auth test accounts.
# Do not deploy these variables or use personal/production user credentials.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
