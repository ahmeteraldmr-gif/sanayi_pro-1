generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["sanayipro"]
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  branches    Branch[]
  roles       Role[]
  memberships OrganizationMembership[]
  customers   Customer[]
  vehicles    Vehicle[]
  suppliers   Supplier[]

  @@map("organizations")
  @@schema("sanayipro")
}

model Branch {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  name                String
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships         BranchMembership[]
  staffMembers        StaffMember[]
  workOrders          WorkOrder[]
  appointments        Appointment[]
  inventoryItems      InventoryItem[]
  quotes              Quote[]
  payments            Payment[]
  expenses            Expense[]
  faultCodeSearches   FaultCodeSearch[]
  vehicleFaultRecords VehicleFaultRecord[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("branches")
  @@schema("sanayipro")
}

model UserProfile {
  id            String                   @id @db.Uuid
  displayName   String                   @map("display_name")
  active        Boolean                  @default(true)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships   OrganizationMembership[]
  platformAdmin PlatformAdmin?

  @@map("user_profiles")
  @@schema("sanayipro")
}

model PlatformAdmin {
  userId    String      @id @map("user_id") @db.Uuid
  email     String      @unique
  active    Boolean     @default(true)
  grantedAt DateTime    @default(now()) @map("granted_at") @db.Timestamptz(3)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("platform_admins")
  @@schema("sanayipro")
}

model OrganizationMembership {
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  roleId         String             @map("role_id") @db.Uuid
  active         Boolean            @default(true)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           UserProfile        @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role               @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branches       BranchMembership[]

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
  @@schema("sanayipro")
}

model BranchMembership {
  branchId       String                 @map("branch_id") @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  roleId         String                 @map("role_id") @db.Uuid
  active         Boolean                @default(true)
  branch         Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)
  role           Role                   @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([branchId, userId])
  @@index([organizationId, userId])
  @@map("branch_memberships")
  @@schema("sanayipro")
}

model Role {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  code           String
  name           String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions    RolePermission[]
  orgMembers     OrganizationMembership[]
  branchMembers  BranchMembership[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@map("roles")
  @@schema("sanayipro")
}

model Permission {
  code  String           @id
  name  String
  roles RolePermission[]

  @@map("permissions")
  @@schema("sanayipro")
}

model RolePermission {
  organizationId String     @map("organization_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code")
  role           Role       @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
  @@schema("sanayipro")
}

model Customer {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  branchId        String?       @map("branch_id") @db.Uuid
  fullName        String        @map("full_name")
  phone           String
  normalizedPhone String        @map("normalized_phone")
  email           String?
  taxNumber       String?       @map("tax_number")
  address         String?
  notes           String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicles        Vehicle[]
  workOrders      WorkOrder[]
  appointments    Appointment[]
  quotes          Quote[]
  payments        Payment[]

  @@unique([id, organizationId])
  @@index([organizationId, normalizedPhone])
  @@index([organizationId, fullName])
  @@map("customers")
  @@schema("sanayipro")
}

model Vehicle {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  customerId          String               @map("customer_id") @db.Uuid
  plate               String
  normalizedPlate     String               @map("normalized_plate")
  brand               String
  model               String
  year                Int?
  vin                 String?
  engineCode          String?              @map("engine_code")
  fuelType            String?              @map("fuel_type")
  transmission        String?
  kilometer           Int                  @default(0)
  color               String?
  active              Boolean              @default(true)
  lastServiceAt       DateTime?            @map("last_service_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer             @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workOrders          WorkOrder[]
  appointments        Appointment[]
  quotes              Quote[]
  faultCodeSearches   FaultCodeSearch[]
  vehicleFaultRecords VehicleFaultRecord[]

  @@unique([id, organizationId])
  @@unique([organizationId, normalizedPlate])
  @@index([organizationId, customerId])
  @@map("vehicles")
  @@schema("sanayipro")
}

model StaffMember {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  branchId       String                 @map("branch_id") @db.Uuid
  userId         String?                @map("user_id") @db.Uuid
  fullName       String                 @map("full_name")
  roleTitle      String                 @map("role_title")
  specialty      String?
  phone          String?
  email          String?
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch         Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments    TechnicianAssignment[]
  appointments   Appointment[]

  @@unique([id, organizationId])
  @@unique([id, organizationId, branchId])
  @@index([organizationId, branchId])
  @@map("staff_members")
  @@schema("sanayipro")
}

model WorkOrder {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  branchId            String                 @map("branch_id") @db.Uuid
  orderNumber         String                 @map("order_number")
  customerId          String                 @map("customer_id") @db.Uuid
  vehicleId           String                 @map("vehicle_id") @db.Uuid
  primaryTechnicianId String?                @map("primary_technician_id") @db.Uuid
  status              String                 @default("RECEIVED")
  approvalStatus      String                 @default("NOT_SENT") @map("approval_status")
  complaint           String
  diagnosis           String                 @default("")
  intakeKilometer     Int?                   @map("intake_kilometer")
  fuelLevel           Int?                   @map("fuel_level")
  intakeChecklistJson Json?                  @map("intake_checklist_json")
  laborTotal          Decimal                @default(0) @map("labor_total") @db.Decimal(12, 2)
  partsTotal          Decimal                @default(0) @map("parts_total") @db.Decimal(12, 2)
  discountTotal       Decimal                @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxRate             Decimal                @default(20) @map("tax_rate") @db.Decimal(5, 2)
  grandTotal          Decimal                @default(0) @map("grand_total") @db.Decimal(12, 2)
  paidAmount          Decimal                @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueAt               DateTime?              @map("due_at") @db.Timestamptz(3)
  completedAt         DateTime?              @map("completed_at") @db.Timestamptz(3)
  version             Int                    @default(1)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch              Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer            Customer               @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle             Vehicle                @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  timelines           WorkOrderTimeline[]
  notes               WorkOrderNote[]
  assignments         TechnicianAssignment[]
  laborItems          WorkOrderLaborItem[]
  partItems           WorkOrderPartItem[]
  partRequests        PartRequest[]
  quotes              Quote[]
  payments            Payment[]
  expenses            Expense[]
  inventoryMovements  InventoryMovement[]
  vehicleFaultRecords VehicleFaultRecord[]

  @@unique([id, organizationId])
  @@unique([id, organizationId, branchId])
  @@unique([organizationId, orderNumber])
  @@index([organizationId, branchId, status])
  @@index([organizationId, vehicleId])
  @@map("work_orders")
  @@schema("sanayipro")
}

model WorkOrderTimeline {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  workOrderId    String    @map("work_order_id") @db.Uuid
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  actorName      String    @map("actor_name")
  eventType      String    @default("STATUS") @map("event_type")
  description    String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  workOrder      WorkOrder @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  @@index([organizationId, workOrderId, createdAt])
  @@map("work_order_timelines")
  @@schema("sanayipro")
}

model WorkOrderNote {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  workOrderId    String    @map("work_order_id") @db.Uuid
  authorUserId   String?   @map("author_user_id") @db.Uuid
  authorName     String    @map("author_name")
  authorRole     String    @default("Usta") @map("author_role")
  content        String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  workOrder      WorkOrder @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  @@index([organizationId, workOrderId, createdAt])
  @@map("work_order_notes")
  @@schema("sanayipro")
}

model TechnicianAssignment {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  branchId         String      @map("branch_id") @db.Uuid
  workOrderId      String      @map("work_order_id") @db.Uuid
  staffMemberId    String      @map("staff_member_id") @db.Uuid
  assignedByUserId String?     @map("assigned_by_user_id") @db.Uuid
  roleInOrder      String      @default("PRIMARY") @map("role_in_order")
  active           Boolean     @default(true)
  assignedAt       DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(3)
  unassignedAt     DateTime?   @map("unassigned_at") @db.Timestamptz(3)
  workOrder        WorkOrder   @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  staffMember      StaffMember @relation(fields: [staffMemberId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  @@unique([workOrderId, staffMemberId])
  @@index([organizationId, branchId, staffMemberId])
  @@map("technician_assignments")
  @@schema("sanayipro")
}

model WorkOrderLaborItem {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  workOrderId    String    @map("work_order_id") @db.Uuid
  name           String
  hours          Decimal   @default(1) @db.Decimal(8, 2)
  hourlyRate     Decimal   @map("hourly_rate") @db.Decimal(12, 2)
  totalPrice     Decimal   @map("total_price") @db.Decimal(12, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  workOrder      WorkOrder @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  @@index([organizationId, workOrderId])
  @@map("work_order_labor_items")
  @@schema("sanayipro")
}

model WorkOrderPartItem {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid
  workOrderId     String         @map("work_order_id") @db.Uuid
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  name            String
  sku             String?
  quantity        Int
  unitPrice       Decimal        @map("unit_price") @db.Decimal(12, 2)
  unitCost        Decimal        @default(0) @map("unit_cost") @db.Decimal(12, 2)
  totalPrice      Decimal        @map("total_price") @db.Decimal(12, 2)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  workOrder       WorkOrder      @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  @@index([organizationId, workOrderId])
  @@map("work_order_part_items")
  @@schema("sanayipro")
}

model Appointment {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  branchId        String       @map("branch_id") @db.Uuid
  customerId      String?      @map("customer_id") @db.Uuid
  vehicleId       String       @map("vehicle_id") @db.Uuid
  staffMemberId   String?      @map("staff_member_id") @db.Uuid
  startsAt        DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime     @map("ends_at") @db.Timestamptz(3)
  durationMinutes Int          @default(60) @map("duration_minutes")
  status          String       @default("Planlandı")
  serviceNote     String       @map("service_note")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch          Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer        Customer?    @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle         Vehicle      @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  staffMember     StaffMember? @relation(fields: [staffMemberId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  @@index([organizationId, branchId, startsAt])
  @@map("appointments")
  @@schema("sanayipro")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  branchId       String?         @map("branch_id") @db.Uuid
  name           String
  contactName    String?         @map("contact_name")
  phone          String?
  email          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("suppliers")
  @@schema("sanayipro")
}

model InventoryItem {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  supplierId     String?             @map("supplier_id") @db.Uuid
  sku            String
  name           String
  stockQty       Int                 @default(0) @map("stock_qty")
  reservedQty    Int                 @default(0) @map("reserved_qty")
  minStockQty    Int                 @default(0) @map("min_stock_qty")
  unitPrice      Decimal             @default(0) @map("unit_price") @db.Decimal(12, 2)
  unitCost       Decimal             @default(0) @map("unit_cost") @db.Decimal(12, 2)
  version        Int                 @default(1)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch         Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplier       Supplier?           @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movements      InventoryMovement[]
  partRequests   PartRequest[]
  orderPartItems WorkOrderPartItem[]

  @@unique([id, organizationId, branchId])
  @@unique([organizationId, branchId, sku])
  @@index([organizationId, branchId])
  @@map("inventory_items")
  @@schema("sanayipro")
}

model InventoryMovement {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  workOrderId     String?       @map("work_order_id") @db.Uuid
  actorUserId     String?       @map("actor_user_id") @db.Uuid
  movementType    String        @map("movement_type")
  quantityDelta   Int           @map("quantity_delta")
  balanceAfter    Int           @map("balance_after")
  unitCost        Decimal?      @map("unit_cost") @db.Decimal(12, 2)
  note            String
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  workOrder       WorkOrder?    @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  @@index([organizationId, branchId, inventoryItemId, createdAt])
  @@map("inventory_movements")
  @@schema("sanayipro")
}

model PartRequest {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid
  workOrderId     String         @map("work_order_id") @db.Uuid
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  partName        String         @map("part_name")
  quantity        Int
  requestedBy     String         @map("requested_by")
  status          String         @default("REQUESTED")
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  workOrder       WorkOrder      @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  @@index([organizationId, branchId, workOrderId])
  @@map("part_requests")
  @@schema("sanayipro")
}

model Quote {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  branchId       String      @map("branch_id") @db.Uuid
  workOrderId    String?     @map("work_order_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  vehicleId      String?     @map("vehicle_id") @db.Uuid
  quoteNumber    String      @map("quote_number")
  status         String      @default("DRAFT")
  subtotalAmount Decimal     @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  validUntil     DateTime?   @map("valid_until") @db.Timestamptz(3)
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch         Branch      @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workOrder      WorkOrder?  @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  customer       Customer?   @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle        Vehicle?    @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items          QuoteItem[]

  @@unique([id, organizationId])
  @@unique([organizationId, quoteNumber])
  @@index([organizationId, branchId])
  @@map("quotes")
  @@schema("sanayipro")
}

model QuoteItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  quoteId        String   @map("quote_id") @db.Uuid
  itemType       String   @default("PART") @map("item_type")
  title          String
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice     Decimal  @map("total_price") @db.Decimal(12, 2)
  status         String   @default("PENDING")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  quote          Quote    @relation(fields: [quoteId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, quoteId])
  @@map("quote_items")
  @@schema("sanayipro")
}

model Payment {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  workOrderId      String    @map("work_order_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  recordedByUserId String?   @map("recorded_by_user_id") @db.Uuid
  amount           Decimal   @db.Decimal(12, 2)
  paymentMethod    String    @default("CASH") @map("payment_method")
  referenceNo      String?   @map("reference_no")
  note             String?
  paidAt           DateTime  @default(now()) @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  branch           Branch    @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workOrder        WorkOrder @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  customer         Customer? @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, workOrderId])
  @@index([organizationId, paidAt])
  @@map("payments")
  @@schema("sanayipro")
}

model Expense {
  id               String     @id @default(uuid()) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  branchId         String     @map("branch_id") @db.Uuid
  workOrderId      String?    @map("work_order_id") @db.Uuid
  recordedByUserId String?    @map("recorded_by_user_id") @db.Uuid
  title            String
  kind             String     @default("expense")
  amount           Decimal    @db.Decimal(12, 2)
  incurredAt       DateTime   @default(now()) @map("incurred_at") @db.Timestamptz(3)
  note             String?
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  branch           Branch     @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workOrder        WorkOrder? @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)

  @@index([organizationId, branchId, incurredAt])
  @@map("expenses")
  @@schema("sanayipro")
}

model FaultCodeSearch {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  branchId            String               @map("branch_id") @db.Uuid
  userId              String?              @map("user_id") @db.Uuid
  vehicleId           String?              @map("vehicle_id") @db.Uuid
  dtcCode             String               @map("dtc_code")
  vehiclePlate        String?              @map("vehicle_plate")
  vehicleModel        String?              @map("vehicle_model")
  technicianNotes     String?              @map("technician_notes")
  queriedAt           DateTime             @default(now()) @map("queried_at") @db.Timestamptz(3)
  branch              Branch               @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle             Vehicle?             @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicleFaultRecords VehicleFaultRecord[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, queriedAt])
  @@map("fault_code_searches")
  @@schema("sanayipro")
}

model VehicleFaultRecord {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  branchId        String           @map("branch_id") @db.Uuid
  vehicleId       String           @map("vehicle_id") @db.Uuid
  workOrderId     String?          @map("work_order_id") @db.Uuid
  faultSearchId   String?          @map("fault_search_id") @db.Uuid
  dtcCode         String           @map("dtc_code")
  titleTr         String           @map("title_tr")
  checklistJson   Json?            @map("checklist_json")
  status          String           @default("OPEN")
  technicianNotes String?          @map("technician_notes")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(3)
  branch          Branch           @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle         Vehicle          @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workOrder       WorkOrder?       @relation(fields: [workOrderId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  faultSearch     FaultCodeSearch? @relation(fields: [faultSearchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, vehicleId])
  @@index([organizationId, workOrderId])
  @@map("vehicle_fault_records")
  @@schema("sanayipro")
}
